# SEO Environment Variables Configuration
# Copy this file to .env.local and fill in the actual values

# Base URL for your website
NEXT_PUBLIC_BASE_URL=https://kandalama.app

# Google Analytics ID (Get from Google Analytics 4)
# https://support.google.com/analytics/answer/9304153
NEXT_PUBLIC_GA_ID=G_XXXXXXXXXX

# Google Search Console Verification Code
# Get this from: https://search.google.com/search-console/about
# Look for the meta tag verification method
NEXT_PUBLIC_GOOGLE_VERIFICATION_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Microsoft Bing Webmaster Tools Verification
# https://www.bing.com/webmasters/
NEXT_PUBLIC_BING_VERIFICATION_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Yandex Webmaster Tools Verification (for Russian/Eastern European users)
# https://webmaster.yandex.com/
NEXT_PUBLIC_YANDEX_VERIFICATION_ID=xxxxxxxxxxxxxxxxxxxx

# Optional: Facebook Pixel (for conversion tracking)
# https://developers.facebook.com/docs/facebook-pixel/
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=xxxxxxxxxxxx

# Optional: Google AdSense (if using for monetization)
# https://adsense.google.com/
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# Cloudinary Configuration (for image optimization)
# https://cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key

# Supabase Configuration
# https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Business Contact Information (optional, for local SEO)
NEXT_PUBLIC_BUSINESS_EMAIL=support@kandalama.app
NEXT_PUBLIC_BUSINESS_PHONE=+94XXXXXXXXX
NEXT_PUBLIC_BUSINESS_ADDRESS=Sri Lanka

# Sitemaps & Robots Configuration

NEXT_PUBLIC_SITEMAP_URL=https://kandalama.app/sitemap.xml
